         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">COEFFICIENTS FOR USE IN THE U.S. ARMY CORPS OF ENGINEERS RESERVOIR MODEL, CE-QUAL-R1 (TECHNICAL REPORT E-83-15) (Appendices A-F)</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">This report supplies information about, and literature values for, many of the coefficients needed for the U.S. Army Corps of Engineers Reservoir Model, CE-OUAL-R1.</rdf:li>
            </rdf:Alt>
